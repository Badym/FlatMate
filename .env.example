# Wzór konfiguracji. Skopiuj do .env i uzupełnij; plik .env nie trafia do repozytorium (SR-10).

# development | production (testy ustawiają testing same)
APP_ENV=development

# Co najmniej 32 znaki: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# PostgreSQL w Dockerze. Hasło tylko z liter i cyfr (trafia do adresu DATABASE_URL):
# python -c "import secrets; print(secrets.token_hex(16))"
POSTGRES_DB=flatmate
POSTGRES_USER=flatmate
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
WEB_PORT=8000

# Adres bazy dla aplikacji uruchamianej poza Dockerem (uv run flask ...).
# 127.0.0.1 zamiast localhost: na Windowsie localhost trafia najpierw na IPv6 i połączenie wisi.
# W kontenerze web docker-compose ustawia go sam.
DATABASE_URL=postgresql+psycopg://flatmate:HASLO_Z_POSTGRES_PASSWORD@127.0.0.1:5432/flatmate

# 1 tylko za reverse proxy (prawdziwy adres IP klienta i HTTPS).
TRUST_PROXY=0

# Hasło kont demo tworzonych przez `flask seed-demo` (co najmniej 12 znaków; nie działa w produkcji).
DEMO_PASSWORD=
