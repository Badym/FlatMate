# Wzór konfiguracji. start.ps1 tworzy z niego lokalny .env z losowymi sekretami.
# Plik .env nie trafia do repozytorium (SR-10).

# development | production (testy ustawiają testing same)
APP_ENV=development

# Uzupełniane losowo przez start.ps1.
SECRET_KEY=

# PostgreSQL w Dockerze. Hasło jest losowe i bezpieczne do użycia w DATABASE_URL.
POSTGRES_DB=flatmate
POSTGRES_USER=flatmate
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
WEB_PORT=8000

# Adres bazy dla aplikacji uruchamianej poza Dockerem.
# W kontenerze web docker-compose ustawia go sam.
DATABASE_URL=postgresql+psycopg://flatmate:HASLO_Z_POSTGRES_PASSWORD@127.0.0.1:5432/flatmate

# 1 tylko za reverse proxy (prawdziwy adres IP klienta i HTTPS).
TRUST_PROXY=0

# Hasło kont demo tworzone losowo przez start.ps1.
DEMO_PASSWORD=

# Baza testów (docker compose --profile test run --rm tests).
TEST_DATABASE_URL=postgresql+psycopg://flatmate:flatmate@127.0.0.1:5434/flatmate_test
